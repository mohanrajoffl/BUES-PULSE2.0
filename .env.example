# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATA_MODE: Prototype mode ("DEMO") or connected authorized real-time feed ("LIVE")
DATA_MODE="DEMO"

# JWT_SECRET: Optional signing secret for session tokens (defaults to ephemeral server key in dev)
JWT_SECRET=
